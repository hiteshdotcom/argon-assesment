# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://argon:argon@localhost:5432/argon?schema=public

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=argon-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Upload limits ---
MAX_UPLOAD_BYTES=15728640      # 15 MB
MIN_FILE_BYTES=20480           # 20 KB
MIN_WIDTH=512
MIN_HEIGHT=512

# --- Validator thresholds ---
BLUR_VARIANCE_MIN=80           # variance-of-Laplacian floor
SIMILARITY_HAMMING_MAX=6       # reject if Hamming distance < this
FACE_AREA_MIN_RATIO=0.05       # largest face / image area floor

# --- Face model (optional) ---
FACE_MODEL_PATH=./models       # face-api weights dir; if missing, face validators are skipped
