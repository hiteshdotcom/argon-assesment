generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
}

model Image {
  id               String      @id @default(uuid())
  originalName     String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  s3Key            String      @unique
  status           ImageStatus @default(PENDING)
  rejectionReasons Json?
  perceptualHash   String?
  faceCount        Int?
  blurScore        Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([perceptualHash])
}
